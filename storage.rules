rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /imagenes-protocolos/{allPaths=**} {
      // Cualquiera con el link puede ver la imagen (necesario para mostrarla en la app).
      allow read: if true;

      // Solo el admin puede subir imágenes nuevas.
      allow write: if request.auth != null &&
        firestore.get(/databases/(default)/documents/perfiles/$(request.auth.uid)).data.rol == 'admin';
    }
  }
}
